# 默认按文本处理，仓库里统一 LF
* text=auto eol=lf

# 这些必须是 LF，否则 Linux/macOS 上 ./gradlew 会报 bad interpreter
gradlew        text eol=lf
*.sh           text eol=lf

# Windows 批处理必须是 CRLF
*.bat          text eol=crlf
gradlew.bat    text eol=crlf

# 二进制，别碰
*.jar  binary
*.p12  binary
*.png  binary
*.jpg  binary
*.webp binary
*.apk  binary

# 让 GitHub 的语言统计别把归档目录算进来
legacy/** linguist-vendored
